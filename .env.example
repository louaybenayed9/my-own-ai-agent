# ===== Core agent (n8n + OpenRouter) =====
# Get a key at https://openrouter.ai/keys (multi-provider: OpenAI, Anthropic, Google, local...)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# Any model slug from https://openrouter.ai/models — override in n8n UI per-node if you prefer
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ===== n8n =====
N8N_PORT=5678
GENERIC_TIMEZONE=UTC

# ===== Service URLs (used inside the n8n workflow via $env) =====
# n8n container -> sibling containers
SKILLS_URL=http://skills:8000
BROWSER_URL=http://browser:8000
# n8n container -> agentmemory REST server running on your host (started by setup/start-agentmemory.cmd)
AGENTMEMORY_REST_URL=http://host.docker.internal:3111/agentmemory

# ===== browser-use sidecar =====
BROWSER_HEADLESS=true
BROWSER_MAX_STEPS=20
