    {
      "parameters": {
        "toolDescription": "Store a durable memory about the user, their preferences, decisions, or a completed task outcome, so future sessions can recall it. Keep the content concise and self-contained.",
        "method": "POST",
        "url": "={{ $env.AGENTMEMORY_REST_URL }}/remember",
        "sendBody": true,
        "specifyBody": "keypair",
        "parametersBody": {
          "values": [
            {
              "name": "content",
              "valueProvider": "modelRequired"
            },
            {
              "name": "project",
              "valueProvider": "fieldValue",
              "value": "personal-agent"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000007",
      "name": "remember_memory",
